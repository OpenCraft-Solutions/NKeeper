  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NKeeper.Abstractions\NKeeper.Abstractions.csproj" />
    <ProjectReference Include="..\NKeeper.Core\NKeeper.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The kernel (docs/architecture.md §1): core services every feature uses. Today the audit log;
    access, the vault, sessions and connectivity arrive in Phase 1.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NKeeper.Core.Persistence\NKeeper.Core.Persistence.csproj" />
  </ItemGroup>

  <!-- The Impacket helper WMI connections run (docs/architecture.md §7.28), shipped beside the server. -->
  <ItemGroup>
    <Content Include="Connectivity\Wmi\wmi_helper.py" Link="Connectivity\wmi_helper.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

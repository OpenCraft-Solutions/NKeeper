<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The ASP.NET Core host: the composition root only. It references core projects, never a plugin
    (plugins are loaded at run time from signed packages, docs/plugin-security.md).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NKeeper.Abstractions\NKeeper.Abstractions.csproj" />
    <ProjectReference Include="..\NKeeper.Core.Persistence\NKeeper.Core.Persistence.csproj" />
    <ProjectReference Include="..\NKeeper.Plugins.Host\NKeeper.Plugins.Host.csproj" />
    <ProjectReference Include="..\NKeeper.Plugins.Packaging\NKeeper.Plugins.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NKeeper.Server.Tests" />
  </ItemGroup>

</Project>

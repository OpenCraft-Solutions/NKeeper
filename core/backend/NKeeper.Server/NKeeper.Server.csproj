<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The ASP.NET Core host: the composition root only. It references core projects, never a plugin
    (plugins are loaded at run time from signed packages, docs/plugin-security.md).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <UserSecretsId>nkeeper-server-2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NKeeper.Abstractions\NKeeper.Abstractions.csproj" />
    <ProjectReference Include="..\NKeeper.Core\NKeeper.Core.csproj" />
    <ProjectReference Include="..\NKeeper.Core.Persistence\NKeeper.Core.Persistence.csproj" />
    <ProjectReference Include="..\NKeeper.Connectivity.Ssh\NKeeper.Connectivity.Ssh.csproj" />
    <ProjectReference Include="..\NKeeper.Identity\NKeeper.Identity.csproj" />
    <ProjectReference Include="..\NKeeper.Plugins.Host\NKeeper.Plugins.Host.csproj" />
    <ProjectReference Include="..\NKeeper.Plugins.Packaging\NKeeper.Plugins.Packaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NKeeper.Server.Tests" />
  </ItemGroup>

  <!-- RPC's NTLM (docs/architecture.md §7.28): .NET's managed NTLM, so Linux needs no GSSAPI module. It's read once, at
       first use, so it's set for the whole process. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.Security.UseManagedNtlm" Value="true" />
  </ItemGroup>

</Project>

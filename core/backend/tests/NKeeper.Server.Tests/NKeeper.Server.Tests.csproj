<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test names use underscores; inline test-data arrays (CA1861) are clearer than static fields. -->
    <NoWarn>$(NoWarn);CA1707;CA2234;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NKeeper.Server\NKeeper.Server.csproj" />
    <ProjectReference Include="..\..\..\..\testing\NKeeper.Testing\NKeeper.Testing.csproj" />
  </ItemGroup>

  <!-- The fake WMI helper (docs/architecture.md §7.28). -->
  <ItemGroup>
    <None Include="Windows\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- RPC's NTLM (docs/architecture.md §7.28): .NET's managed NTLM, so Linux needs no GSSAPI module. It's read once, at
       first use, so it's set for the whole process. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Net.Security.UseManagedNtlm" Value="true" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plugin SDK: contracts only. Plugins reference this assembly and nothing else from core,
    and it is shared with them from the server's default load context (docs/plugin-security.md §7.1).
    ASP.NET Core is a shared framework too, so its abstractions may appear in the contracts.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NKeeper.Abstractions</PackageId>
    <Description>The NKeeper plugin SDK for backends: the contracts a plugin implements and the services core gives it. A plugin references this package and nothing else of core's.</Description>
  </PropertyGroup>

  <Import Project="../../packaging/Package.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Only core creates and reads credential handles (docs/architecture.md §7.6). -->
  <ItemGroup>
    <InternalsVisibleTo Include="NKeeper.Core" />
  </ItemGroup>

</Project>

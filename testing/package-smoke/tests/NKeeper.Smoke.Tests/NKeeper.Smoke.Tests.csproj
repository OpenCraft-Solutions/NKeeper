<Project Sdk="Microsoft.NET.Sdk">

  <!-- A plugin repository's tests: the test server and fixtures from the NKeeper.Testing package, the plugin's own package loaded into it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NKeeperSmokeVersion Condition="'$(NKeeperSmokeVersion)' == ''">1.0.0</NKeeperSmokeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NKeeper.Testing" Version="$(NKeeperSmokeVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built first, so its package (artifacts/plugins) is there to load; not referenced as an assembly. -->
    <ProjectReference Include="../../backend/NKeeper.Smoke.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

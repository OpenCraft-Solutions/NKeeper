<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only the packages core would publish (packed into feed/ by smoke.sh) and nuget.org: never core's projects. -->
  <packageSources>
    <clear />
    <add key="local" value="feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="NKeeper.Abstractions" />
      <package pattern="NKeeper.Plugin.Build" />
      <package pattern="NKeeper.Testing" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

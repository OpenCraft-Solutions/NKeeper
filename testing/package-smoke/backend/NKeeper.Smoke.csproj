<Project Sdk="Microsoft.NET.Sdk">

  <!-- What a plugin repository's backend project looks like: the build package, and nothing else of NKeeper's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>NKeeper.Smoke</RootNamespace>
    <NKeeperSmokeVersion Condition="'$(NKeeperSmokeVersion)' == ''">1.0.0</NKeeperSmokeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NKeeper.Plugin.Build" Version="$(NKeeperSmokeVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test helpers: test plugin packages, a PostgreSQL fixture. Referenced only by test projects. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\backend\NKeeper.Plugins.Packaging\NKeeper.Plugins.Packaging.csproj" />
    <ProjectReference Include="..\..\core\backend\NKeeper.Core.Persistence\NKeeper.Core.Persistence.csproj" />
    <!--
      Built first, but not referenced as an assembly: the test plugin must not be in the test process's
      trusted platform assemblies, or it would count as shared (§7.1) and load in the default context.
    -->
    <ProjectReference Include="..\plugins\NKeeper.TestPlugins.Hello\NKeeper.TestPlugins.Hello.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\ssh\backend\NKeeper.Plugins.Ssh.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\wake-on-lan\backend\NKeeper.Plugins.WakeOnLan.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\web\backend\NKeeper.Plugins.Web.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\desktop\backend\NKeeper.Plugins.Desktop.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="HelloPluginPath" Value="$(MSBuildThisFileDirectory)../plugins/NKeeper.TestPlugins.Hello/bin/$(Configuration)/$(TargetFramework)/NKeeper.TestPlugins.Hello.dll" />
    <AssemblyMetadata Include="SshPluginPath" Value="$(MSBuildThisFileDirectory)../../plugins/ssh/backend/bin/$(Configuration)/$(TargetFramework)/NKeeper.Plugins.Ssh.dll" />
    <AssemblyMetadata Include="SshPluginManifest" Value="$(MSBuildThisFileDirectory)../../plugins/ssh/backend/nkeeper-plugin.json" />
    <AssemblyMetadata Include="SshPluginFrontend" Value="$(MSBuildThisFileDirectory)../../plugins/ssh/frontend/dist" />
    <AssemblyMetadata Include="WakeOnLanPluginPath" Value="$(MSBuildThisFileDirectory)../../plugins/wake-on-lan/backend/bin/$(Configuration)/$(TargetFramework)/NKeeper.Plugins.WakeOnLan.dll" />
    <AssemblyMetadata Include="WebPluginOutput" Value="$(MSBuildThisFileDirectory)../../plugins/web/backend/obj/$(Configuration)/$(TargetFramework)/package" />
    <AssemblyMetadata Include="DesktopPluginOutput" Value="$(MSBuildThisFileDirectory)../../plugins/desktop/backend/obj/$(Configuration)/$(TargetFramework)/package" />
    <AssemblyMetadata Include="DesktopPluginManifest" Value="$(MSBuildThisFileDirectory)../../plugins/desktop/backend/nkeeper-plugin.json" />
    <AssemblyMetadata Include="DesktopPluginFrontend" Value="$(MSBuildThisFileDirectory)../../plugins/desktop/frontend/dist" />
    <AssemblyMetadata Include="WebPluginManifest" Value="$(MSBuildThisFileDirectory)../../plugins/web/backend/nkeeper-plugin.json" />
    <AssemblyMetadata Include="WebPluginFrontend" Value="$(MSBuildThisFileDirectory)../../plugins/web/frontend/dist" />
    <AssemblyMetadata Include="WakeOnLanPluginManifest" Value="$(MSBuildThisFileDirectory)../../plugins/wake-on-lan/backend/nkeeper-plugin.json" />
  </ItemGroup>

</Project>

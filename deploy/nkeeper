#!/bin/sh
# NKeeper's command line (docs/plugin-security.md §9), installed by deploy/setup.sh as /usr/bin/nkeeper: the server
# binary's commands, such as `nkeeper plugin upgrade` or `nkeeper admin reset-password`, with the settings they need
# from the server's settings file, which only root can read.
set -eu
if [ -r /etc/nkeeper/nkeeper.env ]; then
    while IFS='=' read -r name value; do
        case $name in
            Plugins__* | ASPNETCORE_ENVIRONMENT | ConnectionStrings__* | DataProtection__*)
                value=${value#\"}
                export "$name=${value%\"}"
                ;;
        esac
    done </etc/nkeeper/nkeeper.env
fi
exec /usr/lib/nkeeper/server/NKeeper.Server "$@"

<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.0-dev</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Every package version is pinned in packages.lock.json; CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- CA1848/CA1873: LoggerMessage source generators are not worth the ceremony at this size. -->
    <!-- CA1515: types used by the SDK, MVC and the test projects must be public. -->
    <!-- CA1711/CA1716/CA1062: noisy for ASP.NET Core conventions with nullable reference types enabled. -->
    <!-- CA2007: there is no synchronization context in ASP.NET Core. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA1711;CA1716;CA1062;CA2007</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
